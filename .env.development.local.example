# Copy to .env.development.local (not committed). Local development lives only here, never in the registry.
# Base config: a deployed stand (what is really running there), or `none` for "only my local remotes":
PORTAL_STAND=uat
# Remotes you run locally (their dev server manifest). A remote not registered on the stand yet works too:
# route /<name>, scopes from its own config.json. Empty value = switched off. Validated when `pnpm dev` starts.
PORTAL_REMOTE_TASKS=http://localhost:5174/mf-manifest.json
# PORTAL_REMOTE_REPORTS=http://localhost:5176/mf-manifest.json
